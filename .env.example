# ───────── Phase 1：Supabase（前端用，公開都冇問題）─────────
# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# 新版 dashboard 叫 Publishable key（sb_publishable_...），即係舊嘅 anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY

# ───────── Phase 2：以下全部只放 server（Vercel Environment Variables），絕對唔可以用 NEXT_PUBLIC_ 開頭 ─────────

# Gemini（https://aistudio.google.com 攞 key；model 名喺 AI Studio 揀一個 Flash model）
GEMINI_API_KEY=
GEMINI_MODEL=
# 每日 AI 次數上限（預設 30）
AI_DAILY_LIMIT=30

# Supabase Secret key（舊名 service_role）。會繞過 RLS，只限 cron 用。永遠唔好放前端。
SUPABASE_SERVICE_ROLE_KEY=

# Web Push（用 `npx web-push generate-vapid-keys` 生成）
# 公開 key 要俾瀏覽器用，所以有 NEXT_PUBLIC_；私鑰唔可以。
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 你個網站網址（唔好放電郵）
VAPID_SUBJECT=https://weight-tracker-ten-xi.vercel.app

# Supabase pg_cron 呼叫 /api/cron/reminders 時用嘅密碼（自己生成一串長隨機字串）
CRON_SECRET=
